{
  "manifest_version": 3,
  "name": "TimePrice",
  "description": "Shows prices as hours of deep work at your net hourly wage. The original price stays visible.",
  "version": "1.0.0",
  "permissions": ["storage", "nativeMessaging", "activeTab"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["engine.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "TimePrice",
    "default_icon": {
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "128": "icons/icon-128.png"
  },
  "browser_specific_settings": {
    "safari": {
      "strict_min_version": "17.0"
    }
  }
}
